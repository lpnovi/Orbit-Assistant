<resources>
    <style name="Theme.Orbit" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B0D12</item>
        <item name="android:statusBarColor">#0B0D12</item>
        <item name="android:colorAccent">#8B7CFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!--
          Orbit's own surface colour. Without this the window inherits the light Material
          background, so any frame before a page has drawn - launching, navigating, or a
          rebuild - shows white behind Orbit's dark UI.
        -->
        <item name="android:windowBackground">#0A0C11</item>
        <!--
          Slide is Orbit's default page transition. Declaring it on the theme means the very
          first navigation matches the default before any preference has been read.
        -->
        <item name="android:windowAnimationStyle">@style/OrbitWindowAnimation.Slide</item>
    </style>

    <!--
      Page transitions, selectable in Settings > Look & Feel > Advanced and applied per window at
      runtime. Android skips window animations entirely when the system animation scale is off,
      so every style below degrades to an immediate navigation with no extra handling.
    -->

    <!-- Shared parent for the selectable page-transition styles below. -->
    <style name="OrbitWindowAnimation" />

    <!-- Slide: destination enters from the right, Back sends it back out to the right. -->
    <style name="OrbitWindowAnimation.Slide">
        <item name="android:activityOpenEnterAnimation">@anim/orbit_slide_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/orbit_slide_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/orbit_slide_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/orbit_slide_close_exit</item>
    </style>

    <!-- Fade and settle: the transition introduced in v0.7.2.5, kept intact as an option. -->
    <style name="OrbitWindowAnimation.Fade">
        <item name="android:activityOpenEnterAnimation">@anim/orbit_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/orbit_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/orbit_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/orbit_activity_close_exit</item>
    </style>

    <!-- None: no Orbit transition at all; navigation completes immediately. -->
    <style name="OrbitWindowAnimation.None">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Theme.Orbit.Bridge" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#8B7CFF</item>
    </style>

    <style name="OrbitPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/orbit_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/orbit_popup_exit</item>
    </style>

</resources>
