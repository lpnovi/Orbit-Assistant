<?xml version="1.0" encoding="utf-8"?>
<!--
  The page being left drifts a short way to the left rather than travelling the full width. The
  small parallax reads as depth without the whole app being thrown across the screen, and it stays
  opaque so nothing shows between the two pages.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:shareInterpolator="true">
    <translate
        android:fromXDelta="0"
        android:toXDelta="-22%p"
        android:duration="210" />
</set>
